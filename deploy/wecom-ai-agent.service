[Unit]
Description=WeCom AI Agent
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/wecom-ai-agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wecom-ai-agent/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
