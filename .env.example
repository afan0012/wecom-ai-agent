# 企业微信「微信客服应用」开启 API 后配置的密钥。未配置时可使用 /demo/chat 本地演示。
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CORP_ID=
WECOM_KF_SECRET=

# 智谱 GLM（OpenAI 兼容接口）。不填则退回本地演示问答。
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash

# 面向外部客户时展示的身份；不要在代码中写死个人资料。
BOT_NAME=我的 Agent
BOT_OWNER_NAME=本人

# 只有放入该目录的 Markdown 才会被轻量检索并提供给模型。
KNOWLEDGE_BASE_DIR=knowledge/approved
KNOWLEDGE_MAX_CHARS=6000

# 将回答交给 FastGPT/RAGFlow 等知识库服务的 HTTP 地址；未填写时使用本地演示知识库。
# RAG_API_URL=https://your-rag-service.example.com/query
# RAG_API_TOKEN=

# 低于该分数的答案会进入人工兜底。范围 0-1。
HANDOFF_THRESHOLD=0.62
